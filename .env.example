# ============================================================
# KAIRI 環境変数サンプル（実際のコードで使用される設定を網羅）
# このファイルを .env にコピーして利用してください。
#   cp .env.example .env   （Windows: copy .env.example .env）
#
# ※重要: この .env.example には必ずダミー値のみを記述してください。
#        実際の API キーをコミットしないこと（.env は gitignore 対象）。
# ============================================================

# ------------------------------------------------------------
# 1. LLM プロバイダー（デフォルトの LLM を選択）
#    有効値: anthropic / openai / gemini / deepseek / local
# ------------------------------------------------------------
LLM_PROVIDER=deepseek

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenAI / OpenAI 互換（DeepSeek 等） ──
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# ── DeepSeek ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Gemini ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── ローカル LLM（Ollama 等、OpenAI 互換エンドポイント） ──
LOCAL_API_KEY=ollama
LOCAL_API_BASE=http://localhost:11434/v1

# ------------------------------------------------------------
# 2. 検索プロバイダー（ニュース・一般検索）
#    未設定の場合は該当プロバイダーがスキップされます。
# ------------------------------------------------------------
# Brave Search（一般検索。英語クエリの精度が高い）
BRAVE_API_KEY=your_brave_api_key_here
# Tavily（AI 向け検索）
TAVILY_API_KEY=your_tavily_api_key_here
# Jina AI（検索 s.jina.ai / 記事フェッチ r.jina.ai）
JINA_API_KEY=your_jina_api_key_here
# Google Custom Search（一般検索の代替）
GOOGLE_CSE_ID=your_google_cse_id_here

# ------------------------------------------------------------
# 3. ニュース & 翻訳 API
# ------------------------------------------------------------
# World News API（無料枠: 250 req/day）
WORLD_NEWS_API_KEY=your_worldnewsapi_key_here
# NewsData.io（無料枠: 200 req/day）
NEWSDATA_API_KEY=your_newsdata_key_here
# DeepL 翻訳
DEEPL_API_KEY=your_deepl_api_key_here
# Google Cloud Translation（プロジェクトID）
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here

# ------------------------------------------------------------
# 4. データベース（Turso クラウド DB / 未設定ならローカル SQLite）
# ------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------
# 5. 通知（Discord 配信）
# ------------------------------------------------------------
# ブリーフィング / アラートの Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------
# 6. 画像生成（Cloudflare Workers AI）
# ------------------------------------------------------------
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------
# 7. IBKR（Interactive Brokers トレーディング連携）
# ------------------------------------------------------------
IBKR_ENABLED=0
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=100
# 有効値: 0 / 1（マーケットデータ取得）
IBKR_MARKET_DATA=0
# 有効値: 1=実データ / 2=遅延データ等
IBKR_MARKET_DATA_TYPE=1

# ------------------------------------------------------------
# 8. アプリ / 認証 / セキュリティ
# ------------------------------------------------------------
# API 認証トークン（本番では必須。空なら開発モードとして許可）
KAIRI_API_TOKEN=
# リリースビルド（1 で /docs /redoc /openapi.json を無効化）
KAIRI_RELEASE=0
# 起動ポート（kairi_desktop）
KAIRI_PORT=8000
# KAIRI_PORT で起動ポートを厳密に固定（占有時フォールバックしない）
KAIRI_PORT_STRICT=0
# クラウド環境（Render 等）で実行中かどうか
KAIRI_CLOUD=0
# テスト用の「今日」の日付を偽装（例: 2026-01-15）
KAIRI_FAKE_TODAY=
# デモ用 KV データをシード投入（1 で有効）
KAIRI_SEED_DEMO_KV=0
# 任意オリジンからの CORS を許可（Tailscale 等、1 で有効）
ALLOW_OPEN_CORS=0

# ------------------------------------------------------------
# 9. トレーディング運用設定（backend/app/core/config.py）
# ------------------------------------------------------------
# 運用資金（円）
CAPITAL_JPY=1000000
# 同時保有上限ポジション数
MAX_POSITIONS=20
# 1 ポジションあたり許容リスク（口座の割合）
ACCOUNT_RISK_PCT=0.015
# 同一セクターの最大保有数
MAX_SAME_SECTOR=2
# 相対強度（RS）最低レーティング
MIN_RS_RATING=70
# VCP（Volatility Contraction Pattern）最低スコア
MIN_VCP_SCORE=55
# 最低プロフィットファクター
MIN_PROFIT_FACTOR=1.1
# ATR ベースのストップロス幅
STOP_LOSS_ATR=2.0
# 目標利確（R 倍率）
TARGET_R_MULTIPLE=2.5