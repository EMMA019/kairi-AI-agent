# ============================================================
# KAIRI 環境変数サンプル（実際のコードで使用される設定を網羅）
# このファイルを .env にコピーして利用してください。
#   cp .env.example .env   （Windows: copy .env.example .env）
#
# ※重要: この .env.example には必ずダミー値のみを記述してください。
#        実際の API キーをコミットしないこと（.env は gitignore 対象）。
#
# ※ほとんどの API キーはフロントエンドの「設定」画面からも登録できます
#  （backend/storage/settings.json に保存され、起動時に env へ自動反映）。
# ============================================================

# ------------------------------------------------------------
# 1. LLM プロバイダー（デフォルトの LLM を選択）
#    有効値: anthropic / openai / gemini / deepseek / local
#    ※Supervisor/Executor のモデル選択はフロントエンド設定（settings.json）
# ------------------------------------------------------------
LLM_PROVIDER=deepseek

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenAI / OpenAI 互換（DeepSeek 等） ──
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# ── DeepSeek ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Gemini ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── ローカル LLM（Ollama 等、OpenAI 互換エンドポイント） ──
LOCAL_API_KEY=ollama
LOCAL_API_BASE=http://localhost:11434/v1

# ------------------------------------------------------------
# 2. 検索プロバイダー（ニュース・一般検索）
#    未設定の場合は該当プロバイダーがスキップされます。
# ------------------------------------------------------------
# Brave Search（一般検索。英語クエリの精度が高い）
BRAVE_API_KEY=your_brave_api_key_here
# Tavily（AI 向け検索）
TAVILY_API_KEY=your_tavily_api_key_here
# Jina AI（検索 s.jina.ai / 記事フェッチ r.jina.ai）
JINA_API_KEY=your_jina_api_key_here

# ------------------------------------------------------------
# 3. ニュース & 翻訳 API
# ------------------------------------------------------------
# World News API（無料枠: 250 req/day）
WORLD_NEWS_API_KEY=your_worldnewsapi_key_here
# NewsData.io（無料枠: 200 req/day）
NEWSDATA_API_KEY=your_newsdata_key_here
# ニュース分析に使う LLM プロバイダー（有効値: deepseek / openai / anthropic / gemini）
NEWS_ANALYZER_PROVIDER=deepseek
# DeepL 翻訳（予備: 現在直接の呼び出し元なし）
DEEPL_API_KEY=
# Google Cloud Translation（プロジェクトID）
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here

# ------------------------------------------------------------
# 4. データベース（Turso クラウド DB / 未設定ならローカル SQLite）
#    ※長期メモリ・pending plan 等はここに保存されます
# ------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------
# 5. 通知（Discord 配信）
# ------------------------------------------------------------
# ブリーフィング / アラートの Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Render デプロイ時（定期配信が自身の公開URLを叩くために使用。ローカルでは空でOK）
RENDER_EXTERNAL_URL=
RENDER_SERVICE_ID=

# ------------------------------------------------------------
# 6. 画像生成（Cloudflare Workers AI）
# ------------------------------------------------------------
# ── Cloudflare Workers AI ──
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here

# ------------------------------------------------------------
# 7. 地図・旅行ツール（travel_route / travel_isochrone / search_nearby_spots）
# ------------------------------------------------------------
# Mapbox（リアルタイム道路・徒歩距離計算。設定画面の mapbox_api_key からも登録可）
MAPBOX_API_KEY=your_mapbox_api_key_here

# ------------------------------------------------------------
# 8. IBKR（Interactive Brokers トレーディング連携）
#    ※接続には TWS / IB Gateway の起動が必要（未接続時は ok=false を返すだけ）
# ------------------------------------------------------------
IBKR_ENABLED=0
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=100
# 有効値: 0 / 1（マーケットデータ取得）
IBKR_MARKET_DATA=0
# 有効値: 1=実データ / 2=遅延データ等
IBKR_MARKET_DATA_TYPE=1

# ------------------------------------------------------------
# 9. Roblox Studio MCP（ゲーム開発連携）
#    ※env ではなく backend/config/mcp_servers.json でサーバー定義
#      （command/args: StudioMCP.exe のパス、autostart: true 等）
#    前提条件:
#      - Roblox Studio が Place を開いた状態で起動中
#      - Studio の アシスタント設定 → MCPサーバーを有効化 が ON
#    ※datamodel_type の補完・アクティブStudio選択は Kairi 側で自動復旧します。
# ------------------------------------------------------------

# ------------------------------------------------------------
# 10. アプリ / 認証 / セキュリティ
# ------------------------------------------------------------
# API 認証トークン（本番では必須。空なら開発モードとして許可）
KAIRI_API_TOKEN=
# リリースビルド（1 で /docs /redoc /openapi.json を無効化）
KAIRI_RELEASE=0
# 起動ポート（kairi_desktop）
KAIRI_PORT=8000
# KAIRI_PORT で起動ポートを厳密に固定（占有時フォールバックしない）
KAIRI_PORT_STRICT=0
# クラウド環境（Render 等）で実行中かどうか
KAIRI_CLOUD=0
# テスト用の「今日」の日付を偽装（例: 2026-01-15）
KAIRI_FAKE_TODAY=
# デモ用 KV データをシード投入（1 で有効）
KAIRI_SEED_DEMO_KV=0
# 任意オリジンからの CORS を許可（Tailscale 等、1 で有効）
ALLOW_OPEN_CORS=0
# レーダー／ブリーフィングのバックグランドスケジューラー（0=オフ / 1=オン。start_kairi.bat の既定は 0）
KAIRI_ENABLE_SCHEDULERS=0
# run_command 等を Docker なしでホスト直接実行することを許可（開発時のみ、1 で有効）
ALLOW_HOST_FALLBACK=0

# ------------------------------------------------------------
# 11. トレーディング運用設定（backend/app/core/config.py）
# ------------------------------------------------------------
# 運用資金（円）
CAPITAL_JPY=1000000
# 同時保有上限ポジション数
MAX_POSITIONS=20
# 1 ポジションあたり許容リスク（口座の割合）
ACCOUNT_RISK_PCT=0.015
# 同一セクターの最大保有数
MAX_SAME_SECTOR=2
# 相対強度（RS）最低レーティング
MIN_RS_RATING=70
# VCP（Volatility Contraction Pattern）最低スコア
MIN_VCP_SCORE=55
# 最低プロフィットファクター
MIN_PROFIT_FACTOR=1.1
# ATR ベースのストップロス幅
STOP_LOSS_ATR=2.0
# 目標利確（R 倍率）
TARGET_R_MULTIPLE=2.5
